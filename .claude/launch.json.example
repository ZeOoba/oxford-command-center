{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "C:/Users/Owner/website-canonical"]
    },
    {
      "name": "brain-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "C:/Users/Owner/oxford-command-center", "run", "dev:web"],
      "port": 5273
    },
    {
      "name": "brain-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "C:/Users/Owner/oxford-command-center", "run", "dev:server:once"],
      "port": 8911
    }
  ]
}
