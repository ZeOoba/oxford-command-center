# Write-back overlay — local user mutations (deal stages, created tasks); never committed
data/overlay.json
# Baked confidential mirror data — regenerated by `npm run bake`, never committed
public/snapshot.json
public/macro.json
# Baked warehouse (Fat Mirror) — computed PFI/Calibration payloads, regenerated by `npm run bake -- --warehouse`
public/warehouse.json
data/alert-state.json
data/alert-inbox.json
data/__test-alert-inbox.json
data/outbox/
data/brief-health.json
# Mirror-deploy run beacon — per-machine run state written by scripts/deploy-mirror.ps1,
# read by scripts/mirror-run-classify.ps1. Machine state, never repo content.
data/_state/
# Financial warehouse — immutable raw copies + sqlite ledger, rebuilt by `npm run warehouse:backfill`, never committed
data/warehouse/
# Persisted document RAG index — built offline by `npm run index:docs`, never committed
data/doc-index.sqlite
data/doc-index.sqlite-shm
data/doc-index.sqlite-wal
data/reindex.log
# Brain Server autostart runtime state (scripts/start-brain-server.ps1) — machine-local
logs/
run/
.superpowers/
# Git worktrees (EnterWorktree / git worktree add) — never committed; node_modules inside these otherwise slows git status to a crawl
.claude/worktrees/
.claude-worktrees/
.worktrees/
# Architect-ack override sentinel for .claude/hooks/file-guard.mjs — machine-local, never committed
.claude/overrides/
# Personal per-machine Claude Code overrides (note: *.local above does NOT match settings.local.json)
.claude/settings.local.json
# Personal desktop launcher config — machine-specific absolute paths (C:/Users/...); keep local, never committed
.claude/launch.json
# Cloudflare Wrangler build/dev cache — regenerated per build, never committed
.wrangler/
# Pre-migration/pre-rebaseline snapshot backups — machine-local, never committed (2026-07-26)
data/_backup/
data/ar-dryrun/
