data/property-financials/golden.local.json
data/cost-seg/golden.local.json
# Code matching tables that name real tenants / entities (synthetic stand-ins in fixtures/synthetic/)
config/local/
# Marker listing the synthetic stand-ins ensure-local-data.ts seeded on this machine
data/.synthetic-seeded.json
# Write-back overlay — local user mutations (deal stages, created tasks); never committed
data/overlay.json
# Property Financials per-insight workflow (owner / due / status) — local user mutations written by
