data/*.corrupt-*
data/__test-alert-inbox.json
data/outbox/
data/brief-health.json
# Mirror-deploy run beacon — per-machine run state written by scripts/deploy-mirror.ps1,
# read by scripts/mirror-run-classify.ps1. Machine state, never repo content.
data/_state/
# Financial warehouse — immutable raw copies + sqlite ledger, rebuilt by `npm run warehouse:backfill`, never committed
data/warehouse/
# Lease market raw CoStar export copies (licensed data; never committed)
data/lease-market/
# Persisted document RAG index — built offline by `npm run index:docs`, never committed
data/doc-index.sqlite
data/doc-index.sqlite-shm
data/doc-index.sqlite-wal
data/reindex.log
# Brain Server autostart runtime state (scripts/start-brain-server.ps1) — machine-local
logs/
run/
# cc-audit-army / cc-eval-plan-premortem workflow scratch handoff (AUDIT-REPORT.md,
# confirmed-findings.json) — regenerated per audit run, never committed
_run/
.superpowers/
# Git worktrees (EnterWorktree / git worktree add) — never committed; node_modules inside these otherwise slows git status to a crawl
.claude/worktrees/
.claude-worktrees/
.worktrees/
# Architect-ack override sentinel for .claude/hooks/file-guard.mjs — machine-local, never committed
.claude/overrides/
# Personal per-machine Claude Code overrides (note: *.local above does NOT match settings.local.json)
.claude/settings.local.json
# Personal desktop launcher config — machine-specific absolute paths (C:/Users/...); keep local, never committed
.claude/launch.json
# Cloudflare Wrangler build/dev cache — regenerated per build, never committed
.wrangler/
# Pre-migration/pre-rebaseline snapshot backups — machine-local, never committed (2026-07-26)
data/_backup/
data/ar-dryrun/
# Encrypted warehouse snapshots + manifest from `npm run backup` (2026-09-17). Encrypted or not,
# firm data never enters git; the real destination is an off-machine BACKUP_DIR.
data/backups/
# Generated from scripts/prepush-confidential-scan.mjs's own JSDoc by `npm run typecheck`'s
# pretypecheck step (tsconfig.confidential-scan-types.json) — never hand-edit, never commit.
# See OI-206 in ~/.claude memory for why this replaced a hand-maintained sibling .d.mts.
scripts/prepush-confidential-scan.d.mts
# AR working dirs: raw tenant delinquency exports (tenant names + arrears). Never committed
# (cc-audit-army 2026-09-28). data/ar-mapping-cache.json and data/ar/review-queue.json are local-only
# too (real-data section above).
data/ar/inbox/
data/ar/processed/
data/ar/failed/
# Property Financials audit layer (GL-level rows per account-month). Firm export: the pre-push scan blocks CSVs
# under data/, so it stays local-only. Regenerate with scripts/property-financials/normalize-raw.ts; tests that need it
# skip with a visible marker when absent. Ruled by Gabriel 2026-10-06.
data/property-financials/monthly-long.csv

# Gate/build output logs (gate-output.log was tracked by mistake).
*.log

# Nothing under data/ is tracked: every real-data file there, and every quarantine / temp / backup copy a
# writer leaves beside one (review-queue.corrupt-<ms>.json, <file>.corrupt-<ts>, <file>.tmp-<pid>), is
# local-only. scripts/fixtures/real-data-manifest.json neverTrack lists data/ too, so a forced add is
# blocked at push and by governance (refute round 5 F5/F9).
/data/
# Quarantine / temp / backup copies of real-data files outside data/ (the push-time block treats a copy
# of any manifest file as real data too).
*.corrupt-*
*.tmp-*
*.bak
*.orig
*.quarantine*
# Copies of real-data files outside data/ (copy rule, refute round 7; the push-time scan and the
# governance check block the same shapes, see scripts/fixtures/real-data-manifest.json _note).
# Editor / writer / Explorer / browser leftovers anywhere:
*~
*.swp
*.tmp
*.temp
*.old
*.backup*
