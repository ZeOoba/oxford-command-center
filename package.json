{
  "name": "oxford-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Brain — Oxford Real Assets internal command center (local-first live 2nd brain)",
  "engines": {
    "node": ">=20"
  },
  "//devServerNote": "dev:server (tsx watch) intermittently hangs before ever binding its port on this machine (~2/5 trials, 2026-07-08) — reproduced via preview_start and raw shell alike; npm --prefix cwd resolution and preview_start's process model were both ruled out as the cause via direct A/B testing. Root cause undetermined, likely transient resource contention on a machine that runs many concurrent node processes. dev:server:once (tsx, no watch) was 5/5 reliable across the same trials and is the launch.json default — no hot-reload, so restart manually after backend edits. See event_log.md 2026-07-08 for the full investigation.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --require ./scripts/dev-watchdog.cjs node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "dev:server:once": "tsx server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "extract": "tsx scripts/extract-workbook.ts",
    "bake": "tsx scripts/bake-mirror.ts",
    "index:docs": "tsx scripts/index-docs.ts",
    "build:mirror": "npm run bake && npm run build",
    "deploy:mirror": "npm run build:mirror && npx wrangler pages deploy dist --project-name=ora-command-center --branch=main",
    "reconcile": "tsx scripts/reconcile.ts",
    "reconcile:leases": "tsx scripts/reconcile-lease-sources.ts",
    "reconcile:noi-crosscheck": "tsx scripts/reconcile-noi-crosscheck.ts",
    "warehouse:backfill": "tsx scripts/warehouse-backfill.ts",
    "warehouse:verify": "tsx scripts/warehouse-verify.ts",
    "warehouse:drift": "tsx scripts/warehouse-live-drift-check.ts",
    "warehouse:import-loss-runs": "tsx scripts/import-insurance-data.ts",
    "worktree": "tsx scripts/safe-worktree.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:dev-css": "tsx scripts/check-dev-css.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:shuffle": "vitest run --sequence.shuffle.files=true --sequence.shuffle.tests=true",
    "pregate": "node scripts/ensure-deps.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "governance": "tsx scripts/governance-check.ts",
    "check:refute": "tsx scripts/check-refute-required.ts",
    "gate": "npm run governance && npm run typecheck && npm run lint && npm run check:dev-css && npm run test && npm run reconcile && npm run reconcile:noi-crosscheck && npm run warehouse:verify && npm run warehouse:drift",
    "gate:ci": "npm run typecheck && npm run lint && npm run check:dev-css && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@hono/node-server": "^1.13.7",
    "@huggingface/transformers": "^4.2.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-virtual": "^3.11.2",
    "@visx/axis": "^3.12.0",
    "@visx/curve": "^3.12.0",
    "@visx/gradient": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^4.0.3",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.15.0",
    "fuse.js": "^7.0.0",
    "hono": "^4.6.14",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-aria-components": "^1.5.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.4",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "uuid": "^14.0.1",
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.25.12": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
